# ================================================================
# PORTFOLIO ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ================================================================

# ── SUPABASE (Required for Admin CMS & Analytics) ───────────────
# Get these from: https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── ADMIN SECURITY ───────────────────────────────────────────────
# A random secret string used to strengthen password hashing
ADMIN_PEPPER=change-this-to-a-long-random-string

# ── CONTACT FORM EMAIL ───────────────────────────────────────────
# Where you want to receive portfolio messages:
CONTACT_EMAIL_TO=your-email@example.com

# OPTION 1: Web3Forms REST API (FREE - easiest)
# Get key from: https://web3forms.com
# WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# OPTION 2: Resend REST API (Free 3,000 emails/month)
# Get key from: https://resend.com
# RESEND_API_KEY=re_your_resend_api_key_here
# CONTACT_EMAIL_FROM="Portfolio Contact" <onboarding@resend.dev>

# OPTION 3: Gmail SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-16-char-app-password
# CONTACT_EMAIL_FROM="Portfolio Contact" <your-gmail@gmail.com>
